# Les arbres du Vive lame (jalon 50)
# ---------------------------------------------------------------------------

msgid "Élancement"
msgstr "Spring"

msgid "La frappe vive frappe plus fort."
msgstr "Quick Strike hits harder."

msgid "Détente"
msgstr "Coil"

msgid "Le bond porte plus loin : la cible se cherche dans un cercle plus large."
msgstr "The leap carries farther: the target is sought in a wider circle."

msgid "Épargne"
msgstr "Thrift"

msgid "La frappe vive coûte moins de mana."
msgstr "Quick Strike costs less mana."

msgid "Impétuosité"
msgstr "Impetuosity"

msgid "Plus le bond est long, plus le coup est fort : un bonus par tranche de {pas_impetuosite} px franchis."
msgstr "The longer the leap, the stronger the blow: a bonus for every {pas_impetuosite} px crossed."

msgid "Premier sang"
msgstr "First Blood"

msgid "Contre un ennemi encore intact, la frappe vive frappe bien plus fort."
msgstr "Against an enemy still unharmed, Quick Strike hits much harder."

msgid "Ouverture"
msgstr "Opening"

msgid "La cible frappée subit davantage de tous vos coups pendant {duree_ouverture} s."
msgstr "The struck target takes more from all your blows for {duree_ouverture} s."

msgid "Coup double"
msgstr "Double Hit"

msgid "Un second coup suit le premier, plus faible."
msgstr "A second, weaker hit follows the first."

msgid "Repli"
msgstr "Withdraw"

msgid "Après le coup, on rebondit de {recul_repli} px vers d'où l'on venait : frapper et sortir."
msgstr "After the blow, you spring back {recul_repli} px toward where you came from: strike and leave."

msgid "Dérobade"
msgstr "Slip Away"

msgid "Le repli rend intouchable {duree_derobade} s."
msgstr "The withdrawal makes you untouchable for {duree_derobade} s."

msgid "Coup sur coup"
msgstr "Blow upon Blow"

msgid "Un ennemi tué par la frappe vive la relance aussitôt, sans payer, sur l'ennemi le plus proche à portée — une relance d'affilée par point."
msgstr "An enemy killed by Quick Strike relaunches it at once, free, at the nearest enemy in range — one relaunch in a row per point."

msgid "Furia"
msgstr "Furia"

msgid "Chaque relance du Coup sur coup frappe plus fort que la précédente."
msgstr "Each Blow upon Blow relaunch hits harder than the one before."

msgid "Fente"
msgstr "Lunge"

msgid "Le bond frappe tout ce qu'il traverse, à {part_fente} % du coup — un geste plus lent."
msgstr "The leap strikes everything it crosses, at {part_fente}% of the blow — a slower gesture."

msgid "Coupe-file"
msgstr "Cut Through"

msgid "Ce que traverse la Fente prend une plus grande part du coup."
msgstr "What the Lunge crosses takes a larger share of the blow."

msgid "Pointe"
msgstr "Point"

msgid "Les estocs de la Rafale frappent plus fort."
msgstr "Flurry's thrusts hit harder."

msgid "Battement"
msgstr "Beat"

msgid "La Rafale se porte plus vite."
msgstr "Flurry is delivered faster."

msgid "Coup d'œil"
msgstr "Keen Eye"

msgid "Les estocs critiquent plus souvent."
msgstr "The thrusts crit more often."

msgid "Fer long"
msgstr "Long Steel"

msgid "Les estocs portent plus loin."
msgstr "The thrusts reach farther."

msgid "Montée"
msgstr "Rise"

msgid "D'un estoc à l'autre, la chance critique monte plus vite : chacun ajoutait {part_rafale} % au précédent."
msgstr "From one thrust to the next, crit chance climbs faster: each added {part_rafale}% to the previous one."

msgid "Insistance"
msgstr "Insistence"

msgid "Un estoc qui frappe la même cible que le précédent frappe plus fort, et le suivant encore plus."
msgstr "A thrust that hits the same target as the previous one hits harder, and the next harder still."

msgid "Pression"
msgstr "Pressure"

msgid "Chaque estoc qui touche rend du mana."
msgstr "Each thrust that lands restores mana."

msgid "Quatrième estoc"
msgstr "Fourth Thrust"

msgid "Un estoc de plus par point dans chaque Rafale, au prix d'un geste plus long."
msgstr "One more thrust per point in each Flurry, at the cost of a longer gesture."

msgid "Botte secrète"
msgstr "Secret Thrust"

msgid "Le dernier estoc de la Rafale est critique à coup sûr."
msgstr "Flurry's last thrust is a sure critical hit."

msgid "Coup de Jarnac"
msgstr "Jarnac's Stroke"

msgid "Le dernier estoc porte deux fois plus loin et traverse tout ce qu'il rencontre."
msgstr "The last thrust reaches twice as far and pierces everything in its way."

msgid "Éventail"
msgstr "Fan"

msgid "Les estocs partent en éventail sur {ouverture_eventail}° : un groupe plutôt qu'un duel, au prix de leurs dégâts."
msgstr "The thrusts fan out over {ouverture_eventail}°: a group rather than a duel, at the cost of their damage."

msgid "Rose des vents"
msgstr "Compass Rose"

msgid "Sous l'Éventail, les estocs se répartissent sur tout le cercle."
msgstr "Under Fan, the thrusts spread over the whole circle."

msgid "Ivresse du sang"
msgstr "Blood Rush"

msgid "Chaque critique de la Rafale ravive les charges de Frénésie de la Soif de sang."
msgstr "Each Flurry critical hit revives Bloodlust's Frenzy charges."

msgid "Carnage"
msgstr "Carnage"

msgid "Par charge de Frénésie, vos attaques font plus de dégâts."
msgstr "Per Frenzy charge, your attacks deal more damage."

msgid "Ivresse"
msgstr "Intoxication"

msgid "Par charge de Frénésie, vous courez plus vite."
msgstr "Per Frenzy charge, you run faster."

msgid "Ténacité"
msgstr "Tenacity"

msgid "Les charges de Frénésie tiennent plus longtemps."
msgstr "Frenzy charges last longer."

msgid "Instinct"
msgstr "Instinct"

msgid "Par charge de Frénésie, vos critiques frappent plus fort."
msgstr "Per Frenzy charge, your critical hits hit harder."

msgid "Sang chaud"
msgstr "Hot Blood"

msgid "Par charge de Frénésie, vous regagnez de la vie chaque seconde."
msgstr "Per Frenzy charge, you regain life every second."

msgid "Moisson"
msgstr "Harvest"

msgid "Chaque charge de Frénésie gagnée rend une part de vos PV max."
msgstr "Each Frenzy charge gained restores a share of your max life."

msgid "Fièvre"
msgstr "Fever"

msgid "Un coup critique d'attaque peut aussi donner une charge de Frénésie."
msgstr "An attack critical hit can also grant a Frenzy charge."

msgid "Lampée"
msgstr "Gulp"

msgid "Un ennemi tué peut donner deux charges au lieu d'une."
msgstr "A killed enemy can grant two charges instead of one."

msgid "Sans fond"
msgstr "Bottomless"

msgid "Une charge de plus au plafond par point, mais elles tiennent moins longtemps."
msgstr "One more charge at the cap per point, but they last less long."

msgid "Berserk"
msgstr "Berserk"

msgid "{charges_berserk} charges de plus au plafond ; à pleines charges, +{vitesse_berserk} % de vitesse d'attaque plus — mais chaque charge vous fait subir davantage."
msgstr "{charges_berserk} more charges at the cap; at full charges, {vitesse_berserk}% more attack speed — but each charge makes you take more damage."

msgid "Sans quartier"
msgstr "No Quarter"

msgid "Sous le Berserk, à pleines charges, chaque ennemi tué d'une attaque éclate : une onde de {rayon_quartier} px, à {part_quartier} % du coup qui l'a tué."
msgstr "Under Berserk, at full charges, each enemy killed by an attack bursts: a {rayon_quartier} px wave at {part_quartier}% of the killing blow."

msgid "Dernier carré"
msgstr "Last Stand"

msgid "À l'échéance, la moitié des charges reste et repart pour une tenue entière."
msgstr "When they expire, half the charges remain and start a full hold again."

msgid "Aiguisage"
msgstr "Whetting"

msgid "Les couteaux frappent plus fort."
msgstr "The knives hit harder."

msgid "Jet tendu"
msgstr "Taut Throw"

msgid "Les couteaux filent plus vite, et donc plus loin."
msgstr "The knives fly faster, and so farther."

msgid "Poignée"
msgstr "Handful"

msgid "Un couteau de plus par point dans l'éventail, chacun un peu plus faible."
msgstr "One more knife per point in the fan, each a little weaker."

msgid "Perce-armure"
msgstr "Armor Piercer"

msgid "Chaque couteau traverse un ennemi de plus, critique ou non."
msgstr "Each knife pierces one more enemy, critical or not."

msgid "Lame chercheuse"
msgstr "Seeking Blade"

msgid "Les couteaux s'infléchissent vers un ennemi proche de leur course."
msgstr "The knives curve toward an enemy near their path."

msgid "Tir lointain"
msgstr "Long Shot"

msgid "Plus un couteau a volé, plus il frappe fort : un bonus par tranche de {pas_tir} px parcourus."
msgstr "The farther a knife has flown, the harder it hits: a bonus for every {pas_tir} px travelled."

msgid "Enfilade"
msgstr "Enfilade"

msgid "Un couteau qui traverse frappe plus fort chaque ennemi suivant."
msgstr "A knife that passes through hits each following enemy harder."

msgid "Retour de lame"
msgstr "Returning Blade"

msgid "En bout de course, les couteaux reviennent vers vous et frappent encore ce qu'ils croisent."
msgstr "At the end of their flight, the knives come back to you and hit again whatever they cross."

msgid "Récupération"
msgstr "Recovery"

msgid "Chaque couteau rattrapé rend du mana."
msgstr "Each knife caught back restores mana."

msgid "Lame plantée"
msgstr "Planted Blade"

msgid "Un couteau qui s'arrête dans un ennemi y reste planté {duree_plantee} s, {plantees_max} au plus ; le Coup de grâce les arrache, +{part_plantee} % de dégâts plus par lame."
msgstr "A knife that stops in an enemy stays planted for {duree_plantee} s, {plantees_max} at most; Coup de Grâce tears them out, {part_plantee}% more damage per blade."

msgid "Ancrage"
msgstr "Anchorage"

msgid "Les lames plantées tiennent plus longtemps."
msgstr "Planted blades stay in longer."

msgid "Hérisson"
msgstr "Hedgehog"

msgid "Chaque lame plantée fait subir davantage de dégâts à son porteur."
msgstr "Each planted blade makes its bearer take more damage."

msgid "Seconde salve"
msgstr "Second Volley"

msgid "Une seconde volée part {ecart_salve} s après la première, à {part_salve} %."
msgstr "A second volley leaves {ecart_salve} s after the first, at {part_salve}%."

msgid "Estocade"
msgstr "Estocade"

msgid "Le Coup de grâce frappe plus fort."
msgstr "Coup de Grâce hits harder."

msgid "Renverse"
msgstr "Reversal"

msgid "Le Coup de grâce repousse sa cible."
msgstr "Coup de Grâce knocks its target back."

msgid "Allonge"
msgstr "Reach"

msgid "La cible se cherche plus loin."
msgstr "The target is sought farther away."

msgid "Dague de miséricorde"
msgstr "Misericord"

msgid "Le Coup de grâce achève plus tôt, charges de Frénésie ou non."
msgstr "Coup de Grâce executes sooner, with Frenzy charges or not."

msgid "Implacable"
msgstr "Relentless"

msgid "Chaque charge de Frénésie consommée vaut davantage : elle donnait +{part_charge_grace} % de dégâts plus."
msgstr "Each Frenzy charge spent is worth more: it gave {part_charge_grace}% more damage."

msgid "Acculé"
msgstr "Cornered"

msgid "Contre un ennemi sous la moitié de sa vie, le Coup de grâce frappe plus fort."
msgstr "Against an enemy below half its life, Coup de Grâce hits harder."

msgid "Défaut de la cuirasse"
msgstr "Chink in the Armor"

msgid "Le coup passe une part de l'armure de sa cible."
msgstr "The blow bypasses part of its target's armor."

msgid "Rançon"
msgstr "Ransom"

