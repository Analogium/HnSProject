msgstr "Knight Master"

msgid "Frappe lourde"
msgstr "Heavy Strike"

msgid "Coup en croix"
msgstr "Cross Slash"

msgid "Épée spirale"
msgstr "Spiral Sword"

msgid "Vague tranchante"
msgstr "Cleaving Wave"

msgid "Cyclone"
msgstr "Cyclone"

msgid "Un coup de taille qui détache son arc et l'envoie devant soi."
msgstr "A slash whose arc breaks free and flies out ahead of you."

msgid "Un tour d'arme entretenu, qui fauche tout ce qui approche."
msgstr "A sustained weapon spin, reaping all that comes close."

msgid "Manuel du froid"
msgstr "Manual of Cold"

msgid "Maître du froid"
msgstr "Master of Cold"

msgid "Pics de glace"
msgstr "Ice Spikes"

msgid "Nova de glace"
msgstr "Ice Nova"

msgid "Tombeau de glace"
msgstr "Frost Tomb"

msgid "Désastre hivernal"
msgstr "Winter Disaster"

msgid "Carapace de givre"
msgstr "Rime Shell"

msgid "Des pics percent le sol au point visé, puis retombent."
msgstr "Spikes pierce the ground at the aimed point, then sink."

msgid "Une déflagration de glace autour de soi, qui transit vite."
msgstr "A blast of ice around you, quick to chill what it hits."

msgid "On s'enferme dans la glace, qui protège et soigne."
msgstr "You seal yourself in ice, which shields and mends."

msgid "Un vortex de glace lâché sous ses pieds, qui ne cesse de croître."
msgstr "A vortex of ice loosed underfoot, growing without pause."

msgid "Manuel sacré"
msgstr "Sacred Manual"

msgid "Maître de la lumière"
msgstr "Master of Light"

msgid "Manuel de magie nécrotique"
msgstr "Necrotic Magic Manual"

msgid "Maître de la nécromancie"
msgstr "Master of Necromancy"

msgid "Peste"
msgstr "Plague"

msgid "Un trait lent qui laisse ce qu'il touche se décomposer."
msgstr "A slow bolt that leaves whatever it strikes to decay."

msgid "Relève"
msgstr "Rise"

msgid "Deux morts-vivants se lèvent et gardent les abords du lanceur."
msgstr "Two undead rise and guard the caster's surroundings."

msgid "Déferlante toxique"
msgstr "Toxic Unleash"

msgid "Un souffle de gaz autour de soi, qui flétrit une fois sur deux."
msgstr "A burst of gas around you that wilts half the time."

msgid "Porte pourrissante"
msgstr "Rotting Gate"

msgid "Un portail crache des créatures qui vont exploser sur les ennemis."
msgstr "A portal spews creatures that burst on enemies."

msgid "Malédiction putride"
msgstr "Putrid Curse"

msgid "Maudit une zone : la nécrose y mord plus profond."
msgstr "Curses an area: necrosis bites deeper there."

msgid "Nécrose avancée"
msgstr "Advanced Necrosis"

msgid "Le corps se ronge lui-même, et ce qu'il touche pourrit plus souvent."
msgstr "The body gnaws at itself, and what it strikes rots more often."

msgid "Nécrose"
msgstr "Necrosis"

msgid "Frappe sacrée"
msgstr "Sacred Strike"

msgid "Pilier sacré"
msgstr "Sacred Pillar"

msgid "Pulsation sacrée"
msgstr "Holy Pulse"

msgid "Lumière sacrée"
msgstr "Holy Light"

msgid "Grâce"
msgstr "Grace"

msgid "Un trait de lumière qui perce tout ce qui est sur sa ligne."
msgstr "A shaft of light piercing all that stands in its line."

msgid "Une colonne de lumière tombe du ciel et brûle sa zone."
msgstr "A column of light falls from the sky and sears its ground."

msgid "Une lumière émane du porteur et frappe par ondes."
msgstr "Light pours from its bearer and strikes in waves."

msgid "Une clarté portée qui protège du sacré et bénit les coups."
msgstr "A worn radiance that wards off holy and blesses your blows."

# Manuels de classe (jalon 28)

msgid "Manuel de la sorcière"
msgstr "Witch's Manual"

msgid "Manuel du Vive lame"
msgstr "Swiftblade's Manual"

msgid "Projectile élémentaire"
msgstr "Elemental Projectile"

msgid "Un trait qui change d'élément à chaque lancer : feu, glace, foudre."
msgstr "A bolt that changes element with each cast: fire, ice, lightning."

msgid "Amplification des sorts"
msgstr "Spell Amplification"

msgid "Un temps, les sorts frappent plus fort."
msgstr "For a while, spells hit harder."

msgid "Sorts amplifiés"
msgstr "Amplified Spells"

msgid "Frappe vive"
msgstr "Quick Strike"

msgid "Se jette d'un coup sur l'ennemi visé à portée et le frappe."
msgstr "Leaps at the targeted enemy in range and strikes it."

msgid "Soif de sang"
msgstr "Bloodlust"

msgid "Chaque ennemi tué par une attaque donne une charge de Frénésie."
msgstr "Each enemy killed by an attack grants a Frenzy charge."

msgid "Frénésie"
msgstr "Frenzy"

