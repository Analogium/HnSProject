msgstr "Buff"

msgid "aux buffs"
msgstr "to buffs"

msgid "de buff"
msgstr "buff"

msgid "de la Persistance"
msgstr "of Persistence"

msgid "dégâts du contrecoup par seconde"
msgstr "backlash damage per second"

