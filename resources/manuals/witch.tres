script = ExtResource("3_noeud")
id = "elemental_projectile_precipitate"
name = "Précipité"
icon = ExtResource("icon_elemental_projectile_precipitate")
description = "Un trait qui touche un ennemi portant les états des deux autres éléments les consomme et les fait réagir, à une part de son coup. Feu sur transi et engourdi : Givre conducteur, le transi gagne ses voisins. Froid sur embrasé et engourdi : Arc ardent, la foudre saute sur ses voisins. Foudre sur embrasé et transi : Vapeur, une explosion autour de lui."
position = Vector2i(1, -1)
parents = Dictionary[String, int]({
"elemental_projectile_electroshock": 1
})
points_max = 2
lines = Array[ExtResource("4_ligne")]([SubResource("L_elemental_projectile_precipitate_0")])

