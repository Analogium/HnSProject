[sub_resource type="Resource" id="N_elemental_projectile_triad"]
script = ExtResource("3_noeud")
id = "elemental_projectile_triad"
name = "Triade"
icon = ExtResource("icon_elemental_projectile_triad")
description = "Trois comètes, une par élément, naissent autour de vous et se rejoignent au point visé. En route, chacune perce ce qu'elle traverse et le frappe de son élément ; à la jonction, elles éclatent ensemble : le coup porte les trois éléments, un tiers chacun, et peut poser les trois états. Un projectile en plus n'ajoute pas de comète : il la fait frapper plus fort. En échange, le geste est plus lent."
position = Vector2i(-1, -1)
parents = Dictionary[String, int]({
"elemental_projectile_arcana": 2,
"elemental_projectile_electroshock": 2
})
points_max = 1
lines = Array[ExtResource("4_ligne")]([SubResource("L_elemental_projectile_triad_0"), SubResource("L_elemental_projectile_triad_1"), SubResource("L_elemental_projectile_triad_2")])
transforms = true
shape = 43

