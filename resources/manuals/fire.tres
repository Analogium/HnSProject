script = ExtResource("3_noeud")
id = "fireball_fragmentation"
name = "Fragmentation"
description = "La boule éclate en petites boules qui partent en étoile : sur chaque ennemi qu'elle traverse, et au bout de sa course — sur un ennemi, un mur ou à portée maximale. Chacune inflige {part_eclat} % des dégâts et explose deux fois plus petit. Elles traversent sans les frapper les ennemis que la boule a déjà touchés."
position = Vector2i(3, 0)
parents = Dictionary[String, int]({
"fireball_piercing": 1,
"fireball_forked_tongue": 1
})
points_max = 3
lines = Array[ExtResource("4_ligne")]([SubResource("L_fireball_fragmentation_0")])

